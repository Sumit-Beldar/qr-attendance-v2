# Node Environment ('production' on Render, 'development' locally)
NODE_ENV=development

# Server Port (assigned by Render or defaults to 3443 locally)
PORT=3443

# Public Base URL (e.g. https://your-app.onrender.com in production)
# In local mode, leave unset to auto-detect LAN IP
PUBLIC_BASE_URL=

# Session Secret (required in production, at least 32 characters)
SESSION_SECRET=

# Turso Database Configuration (leave unset for local SQLite file in ./data/app.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Setup Key for initial teacher account creation on public URL (required in production)
SETUP_KEY=

# Application Timezone for server-formatted dates and CSV exports (default: Asia/Kolkata)
APP_TIMEZONE=Asia/Kolkata
